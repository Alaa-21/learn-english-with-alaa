                    { "en": "They are at home.", "ar": "هم في المنزل.", "vocab": ["They", "home"] },
                    { "en": "I am not tired.", "ar": "أنا لست متعباً.", "vocab": ["I", "tired", "not"] },
                    { "en": "Is he ready?", "ar": "هل هو مستعد؟", "vocab": ["He", "ready"] },
